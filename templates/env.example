# ========== init-kb-harness 配置（示例）==========
# 复制为 .env 并填入真实值。脚本通过 common.py 自动发现仓库根（找 AGENTS.md + .meta/）。
#
# ⚠️ API key 是所有 LLM 调用的唯一合法源。禁止字面值嵌入 prompt/输出/笔记
#    （原则依据见 docs/CONSTITUTION.md 与 AGENTS.md 约束速查）。

# ─── 安装模式（LLM 层开关；语义层不受它影响）───
# lite（默认）：零 LLM API。检索 = 语义层（本地内置模型）+ BM25 + 图谱 + agentic grep/glob。
# full：额外启用 DeepSeek 摘要 / tag / 合成 / 语义精排（--rerank/--deep）。需填 DEEPSEEK_API_KEY。
# 注：shell 环境变量仅当本文件中已存在该键时才会覆盖（common.py load_env 行为）——
#     要改模式请直接改本文件，不要只设 shell 环境变量。
HARNESS_MODE=lite

# ─── 语义层（基础能力，默认启用）───
# 本套件面向含大量 office/非结构化文件的仓库，语义召回是基本盘。默认走内置本地模型：
#   内置模型 bge-small-zh-v1.5（fastembed + onnxruntime，512 维，离线可跑，零 API）
#   离线套装已预置 wheel 与模型缓存；若手工安装：pip install fastembed（首次会下载 ~95MB）
# 需要更强/更高维的嵌入时改指任意 OpenAI 兼容端点，然后重建向量库（embed.py --full）。
#
# EMBED_PROVIDER：
#   auto（默认）  配了 EMBED_BASE_URL+EMBED_MODEL → http；否则用内置模型（builtin）
#   http          任意 OpenAI 兼容 /embeddings（本地 Ollama / vLLM / LM Studio，或云端）
#   builtin       强制内置模型
#   off           显式关闭（仅排障；维护与查询都会明确告警）
# 注意：base_url / model 只填一个会报配置错误，不会静默改用内置模型。
#
# 【http 示例】本地 Ollama：ollama pull qwen3-embedding:4b
#       EMBED_BASE_URL=http://127.0.0.1:11434/v1
#       EMBED_MODEL=qwen3-embedding:4b
#   云端智谱：EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#       EMBED_MODEL=embedding-3  EMBED_API_KEY=<key>
# 【builtin】EMBED_MODEL 留空 = BAAI/bge-small-zh-v1.5
#       模型缓存目录（留空 = ~/.cache/fastembed）；国内可设 HF_ENDPOINT=https://hf-mirror.com
#       EMBED_CACHE_DIR=
#
# 维度以实测为准（EMBED_DIM 只在模型支持降维时才需要填）。
# 换模型/维度/分块后必须显式重建：python .meta/scripts/embed.py --full
#   （先写临时表，全部成功后才在一条事务里切换；任何一片失败都不切换）
EMBED_PROVIDER=auto
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=
EMBED_DIM=
# 分块（字符数 / 重叠）。默认随来源：http 3000/300，builtin 450/50。
# 注意：BM25 用自己固定的 3000/300 粒度，不受这里影响。
# EMBED_CHUNK_CHARS=
# EMBED_CHUNK_OVERLAP=
# 单次请求/单批推理的块数；builtin 的扁平批量每批多少篇 / 单批 chunk 上限（控内存）
EMBED_BATCH=32
EMBED_FILE_BATCH=64
EMBED_CHUNK_BATCH=2048
# 查询侧 HTTP 超时（秒）：端点挂起时避免一次 ask 拖几分钟
EMBED_QUERY_TIMEOUT=20
# 语义关联阈值（.meta/links/ 写入线 / 高度相关分档）。换模型后建议校准；
# 改阈值会自动触发 links 重建。图谱收边另用 SEMANTIC_THRESHOLD。
# LINKS_SIM_THRESHOLD=0.70
# LINKS_HIGH_THRESHOLD=0.85
# SEMANTIC_THRESHOLD=0.75

# ─── LLM 层（仅 HARNESS_MODE=full）───
# 换厂商改 base_url/model 即可（OpenAI 兼容 chat/completions）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 选型：取最新代 DeepSeek 的次等型号——批量维护任务讲究成本控制，旗舰型号不划算。
DEEPSEEK_MODEL=deepseek-v4-flash

# ─── 兼容旧配置 ───
# 只填了 ZHIPU_API_KEY / ZHIPU_BASE_URL / ZHIPU_EMBED_MODEL 的旧仓库会被自动识别为
# 语义层端点，无需迁移；新装请直接用上面的 EMBED_*。

# ─── 主机识别（多机同步时区分主从）───
# hostname 命令获取本机名；PRIMARY_HOST = 主机名，非主机自动只读
PRIMARY_HOST=
# 可选：显式指定仓库根（默认自动发现）
VAULT_ROOT=

# ─── 维护参数（可调）───
# 维护批量任务（embed/summarize API 调用、office 提取）的并发数
MAINTAIN_CONCURRENCY=6
API_RATE_LIMIT_MS=200

# ask.py 低置信自动升级阈值（final top-1 低于此值触发 hybrid/deep 升级）。
# 默认 0.6 是面向云端 embedding 的启发式；换本地模型后建议用
# .meta/escalation-stats.jsonl 校准再固定。
# ESCALATION_THRESHOLD=0.6

# ─── Office 文档提取（extract_office.py）───
# 参与提取的扩展名（逗号分隔）；.doc/.xls/.ppt 老格式不支持，会登记提示转存
OFFICE_EXTRACT_EXTS=.docx,.xlsx,.pptx,.pdf
# 单文件提取文本上限（字符，0=不限）
OFFICE_EXTRACT_MAX_CHARS=200000
# xlsx 每 sheet 最大提取行数（0=不限）
OFFICE_EXTRACT_MAX_ROWS=2000
# 并行提取路数（默认跟随 MAINTAIN_CONCURRENCY）
# OFFICE_EXTRACT_WORKERS=6
# 单文件硬超时（秒，可为小数；0=不限）。超时即终止该子进程、跳过并登记
# .meta/office-extracts/_timeouts.md，不会拖死整轮维护。
OFFICE_EXTRACT_TIMEOUT_S=120

# ─── 大文件闸门（硬约束，嵌入/LLM 管线）───
# 单文件超过该大小（MB）不直接进嵌入/LLM 管线（embed/summarize），挂起登记到
# .meta/large-files-pending.md，维护完成后 agent 向用户询问处理方式，决定写入
# .meta/rules/large-file-policy.md。BM25/图谱/索引不受影响。
LARGE_FILE_THRESHOLD_MB=1

# ─── 治理（Phase 3）───
# converge SKILL 产物落点（对齐 .meta/ 归属，勿用默认 .converge/）
CONVERGE_DIR=.meta/converge

# 归档判定关键字（逗号分隔，路径段含任一即归档区，不计入孤儿告警）
ARCHIVE_MARKERS=归档,archive,archived

# 日记/日志类目录标记（knowledge_map 的"日记社区凝结新主题"信号）
JOURNAL_MARKERS=日记,journal,diary,log

# health_report 告警阈值（按目标仓库规模调）
INBOX_ALERT_THRESHOLD=5
ORPHAN_ALERT_THRESHOLD=20
SPARSE_CATEGORY_MIN=3

# 隐私目录（逗号分隔；也支持 .meta/rules/category-privacy.md 自动扫描）
PRIVACY_DIRS=
