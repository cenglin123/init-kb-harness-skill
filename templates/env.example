# ========== init-kb-harness 配置（示例）==========
# 复制为 .env 并填入真实值。脚本通过 common.py 自动发现仓库根（找 AGENTS.md + .meta/）。
#
# ⚠️ API key 是所有 LLM 调用的唯一合法源。禁止字面值嵌入 prompt/输出/笔记
#    （原则依据见 docs/CONSTITUTION.md 与 AGENTS.md 约束速查）。

# ─── 安装模式（核心开关）───
# lite（简化版，默认）：零 API、零嵌入库。检索 = agentic grep/glob（由运维 agent 兼任
#   LLM 角色）+ BM25 本地索引 + 图谱/反链 + 文件夹分类；maintain.py 跳过
#   embed/summarize 等 LLM 步骤。
# full（完整版）：加 embeddings.sqlite（Zhipu）+ DeepSeek 总结/合成/精排，
#   需填下方两把 API key。
# lite → full 升级：填 key + 改本项为 full + 跑一次 maintain.py --full。
HARNESS_MODE=lite

# ─── LLM / Embedding（仅完整版必填，换后端需改 common.py）───
# 换后端需改 .meta/scripts/common.py 的 client 类（Phase 1 不提供工厂）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 选型：取最新代 DeepSeek 的次等型号——批量维护任务讲究成本控制，旗舰型号不划算。
# DeepSeek 出新代时改这里为该代次等型号，并同步 common.py 的默认值。
DEEPSEEK_MODEL=deepseek-v4-flash

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBED_MODEL=embedding-3
ZHIPU_EMBED_DIM=2048

# ─── 主机识别（多机同步时区分主从）───
# hostname 命令获取本机名；PRIMARY_HOST = 主机名，非主机自动只读
PRIMARY_HOST=
# 可选：显式指定仓库根（默认自动发现）
VAULT_ROOT=

# ─── 维护参数（可调）───
# 维护批量任务（embed/summarize API 调用、office 提取）的并发数
MAINTAIN_CONCURRENCY=6
API_RATE_LIMIT_MS=200

# ─── Office 文档提取（extract_office.py）───
# 参与提取的扩展名（逗号分隔）；.doc/.xls/.ppt 老格式不支持，会登记提示转存
OFFICE_EXTRACT_EXTS=.docx,.xlsx,.pptx,.pdf
# 单文件提取文本上限（字符，0=不限）
OFFICE_EXTRACT_MAX_CHARS=200000
# xlsx 每 sheet 最大提取行数（0=不限）
OFFICE_EXTRACT_MAX_ROWS=2000

# ─── 治理（Phase 3）───
# converge SKILL 产物落点（对齐 .meta/ 归属，勿用默认 .converge/）
CONVERGE_DIR=.meta/converge

# 归档判定关键字（逗号分隔，路径段含任一即归档区，不计入孤儿告警）
ARCHIVE_MARKERS=归档,archive,archived

# 日记/日志类目录标记（knowledge_map 的"日记社区凝结新主题"信号）
JOURNAL_MARKERS=日记,journal,diary,log

# health_report 告警阈值（按目标仓库规模调）
INBOX_ALERT_THRESHOLD=5
ORPHAN_ALERT_THRESHOLD=20
SPARSE_CATEGORY_MIN=3

# 隐私目录（逗号分隔；也支持 .meta/rules/category-privacy.md 自动扫描）
PRIVACY_DIRS=
