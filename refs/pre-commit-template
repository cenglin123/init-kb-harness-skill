#!/bin/bash
# init-kb-harness pre-commit hook（统一版；Phase 1-3 必装同一份）
#
# 检查项：
#   1. plan status 检查（依赖 check_plan_status.py，随 bundle 安装）
#   2. plan 假完成检查（frontmatter 正则，无外部依赖）
#   3. converge 产物路径纠正（.converge/ → .meta/converge/，硬拦截）
#   4. converge 未归档提醒（软警告）
#   5. 治理文档变更提醒（读 .meta/governed-files.txt SSOT，存在则用、不存在跳过）
#   6. API key 泄露扫描
#   7. 隐私目录写入拦截（若 category-privacy.md 定义）
#   8. 三文件一致性（AGENTS/CLAUDE/GEMINI MD5）
#   9. MEMORY.md 记忆索引一致性（硬约束：索引由 memory_index.py 自动维护）
#
# 实现要点：
#   - GOV 检测读 .meta/governed-files.txt（SSOT，每行一个 glob）
#   - 治理走 converge + fresh verifier：执行前 converge 收敛、执行后 fresh verifier 验收

STAGED_FILES=$(git diff --cached --name-only)

# ─── 1. plan status 检查（依赖 check_plan_status.py；脚本缺失时跳过） ───
PLAN_STATUS_CHECK_NEEDED=0
while IFS= read -r path; do
    case "$path" in
        docs/plans/*) PLAN_STATUS_CHECK_NEEDED=1 ;;
    esac
done <<< "$STAGED_FILES"

if [ "$PLAN_STATUS_CHECK_NEEDED" -eq 1 ]; then
    if [ -f ".meta/scripts/check_plan_status.py" ]; then
        if ! python .meta/scripts/check_plan_status.py --full; then
            echo ""
            echo "⚠️  docs/plans 状态检查失败。"
            echo "请先修正 frontmatter status 与目录一致，再重新 stage/commit。"
            exit 1
        fi
    fi
fi

# ─── 2. plan 假完成检查（frontmatter 正则，无外部依赖） ───
# 防止"假完成"：status:done 但完工检查清单仍残留 - [ ]
PLAN_FAKE_DONE_HITS=""
while IFS= read -r path; do
    case "$path" in
        docs/plans/*.md)
            [ ! -f "$path" ] && continue
            if head -20 "$path" | grep -q 'status:\s*done'; then
                if grep -qE '^\s*- \[ \]' "$path"; then
                    PLAN_FAKE_DONE_HITS="$PLAN_FAKE_DONE_HITS\n  - $path"
                fi
            fi
            ;;
    esac
done <<< "$STAGED_FILES"

if [ -n "$PLAN_FAKE_DONE_HITS" ]; then
    echo "⚠️  Git commit 被拒绝：plan 假完成"
    echo ""
    echo "以下 plan 文件 frontmatter 声明 status: done，但完工检查清单仍有未勾选项 (- [ ])："
    echo -e "$PLAN_FAKE_DONE_HITS"
    echo ""
    echo "请将所有完工检查清单项勾选为 - [x] 后再提交。"
    exit 1
fi

# ─── 3. converge 产物路径纠正（硬拦截） ───
# converge SKILL 默认落 .converge/；本仓库统一落 .meta/converge/（.env:CONVERGE_DIR）。
CONVERGE_MISPLACED=""
while IFS= read -r path; do
    case "$path" in
        .converge/*) CONVERGE_MISPLACED="$CONVERGE_MISPLACED\n  - $path" ;;
    esac
done <<< "$STAGED_FILES"

if [ -n "$CONVERGE_MISPLACED" ]; then
    echo "⚠️  Git commit 被拒绝：converge 产物落错位置"
    echo -e "$CONVERGE_MISPLACED"
    echo ""
    echo "converge 产物应落 .meta/converge/（.env 已设 CONVERGE_DIR=.meta/converge）。"
    echo "请 git mv .converge/* .meta/converge/ 后重新提交。"
    exit 1
fi

# ─── 4. converge 未归档提醒（软警告，不拦截） ───
# 目录不存在时静默跳过。
STALE_CONVERGE=$(find .meta/converge/active/ -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
if [ -n "$STALE_CONVERGE" ]; then
    echo "📋 尚有未归档的 converge 收敛目录（软警告，不拦截提交）"
    echo "$STALE_CONVERGE" | sed 's/^/    - /'
    echo "  若已收敛完成，请将目录移至 .meta/converge/done/。"
fi

# ─── 5. 治理文档变更提醒（参数化：读 .meta/governed-files.txt SSOT） ───
# 文件存在则按其每行 glob 检测；不存在则整段跳过。
# 每行一项 glob（# 开头注释、空行跳过）。
GOV_LIST=".meta/governed-files.txt"
if [ -f "$GOV_LIST" ]; then
    SSOT_CHANGED=0
    GOV_HITS=""
    while IFS= read -r path; do
        # SSOT 自身变更
        if [ "$path" = "$GOV_LIST" ]; then
            SSOT_CHANGED=1
        fi
        # 与清单每行 glob 匹配
        while IFS= read -r pattern; do
            [ -z "$pattern" ] && continue
            case "$pattern" in '#'*) continue ;; esac
            case "$path" in
                $pattern)
                    GOV_HITS="$GOV_HITS\n  - $path"
                    break
                    ;;
            esac
        done < "$GOV_LIST"
    done <<< "$STAGED_FILES"

    if [ "$SSOT_CHANGED" -eq 1 ]; then
        echo "📋 检测到治理文档 SSOT 变更（$GOV_LIST）"
        echo "  SSOT 定义了治理文档清单边界，改此文件相当于改写全部门控边界。"
        echo "  按宪法要求必须走 ultraverge 流程（≥3 独立 reviewer、≥2 lineage、≥1 fresh-context）。"
    fi
    if [ -n "$GOV_HITS" ]; then
        echo "📋 检测到治理文档变更（软警告，不拦截提交）"
        echo -e "$GOV_HITS"
        echo "  按宪法要求，治理文档改动应走 ultraverge 流程（≥3 独立 reviewer、≥2 lineage、≥1 fresh-context）。"
    fi
fi

# ─── 6. API key 泄露扫描 ───
KEY_LEAK_PATTERN='sk-[a-zA-Z0-9]{20,}'
KEY_LEAK_WHITELIST_REGEX='^(\.env\.example|\.meta/tests/|.*\.example\..*)'
KEY_LEAK_HITS=""
while IFS= read -r path; do
    echo "$path" | grep -qE "$KEY_LEAK_WHITELIST_REGEX" && continue
    [ ! -f "$path" ] && continue
    if grep -qE "$KEY_LEAK_PATTERN" "$path" 2>/dev/null; then
        hit_lines=$(grep -nE "$KEY_LEAK_PATTERN" "$path" 2>/dev/null | head -3 | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')
        KEY_LEAK_HITS="$KEY_LEAK_HITS\n  - $path (行 $hit_lines)"
    fi
done <<< "$STAGED_FILES"

if [ -n "$KEY_LEAK_HITS" ]; then
    echo "⚠️  Git commit 被拒绝：检测到疑似 API key 泄露"
    echo ""
    echo "以下 stage 文件含 \`sk-[a-zA-Z0-9]{20,}\` 模式（疑似真实 API key）："
    echo -e "$KEY_LEAK_HITS"
    echo ""
    echo "API-KEY 必须走 \`.env\`。"
    echo "如确属占位符 / 测试 fixture，将路径前缀加到 KEY_LEAK_WHITELIST_REGEX。"
    exit 1
fi

# ─── 7. 隐私目录写入拦截 ───
# 注意：common.py 用 Python \w 正则解析同文件，匹配稍宽；本 hook 是更粗的守卫。
PRIVACY_FILE=".meta/rules/category-privacy.md"
PRIVACY_DIRS_LIST=""
if [ -n "$PRIVACY_DIRS" ]; then
    PRIVACY_DIRS_LIST="$PRIVACY_DIRS"
elif [ -f "$PRIVACY_FILE" ]; then
    PRIVACY_DIRS_LIST=$(grep -oE '[A-Za-z0-9]+【[^】]+】|`[^`]+/`|private/|secrets/|credentials/' "$PRIVACY_FILE" 2>/dev/null | tr '\n' ',' | sed 's/`//g')
fi
if [ -n "$PRIVACY_DIRS_LIST" ]; then
    PRIVACY_HITS=""
    while IFS= read -r path; do
        IFS=',' read -ra DIRS <<< "$PRIVACY_DIRS_LIST"
        for pdir in "${DIRS[@]}"; do
            [ -z "$pdir" ] && continue
            case "$path" in
                "$pdir"/*) PRIVACY_HITS="$PRIVACY_HITS\n  - $path ($pdir)" ;;
            esac
        done
    done <<< "$STAGED_FILES"
    if [ -n "$PRIVACY_HITS" ]; then
        echo "⚠️  Git commit 被拒绝：检测到隐私目录文件被 stage"
        echo -e "$PRIVACY_HITS"
        echo "隐私目录受 $PRIVACY_FILE 保护，禁止提交。"
        exit 1
    fi
fi

# ─── 8. 三文件一致性（AGENTS/CLAUDE/GEMINI MD5） ───
AGENTS_FILE="AGENTS.md"
CLAUDE_FILE="CLAUDE.md"
GEMINI_FILE="GEMINI.md"

if [ ! -f "$AGENTS_FILE" ] || [ ! -f "$CLAUDE_FILE" ] || [ ! -f "$GEMINI_FILE" ]; then
    exit 0
fi

if command -v md5sum &> /dev/null; then
    AGENTS_MD5=$(md5sum "$AGENTS_FILE" | cut -d' ' -f1)
    CLAUDE_MD5=$(md5sum "$CLAUDE_FILE" | cut -d' ' -f1)
    GEMINI_MD5=$(md5sum "$GEMINI_FILE" | cut -d' ' -f1)
elif command -v md5 &> /dev/null; then
    AGENTS_MD5=$(md5 -q "$AGENTS_FILE")
    CLAUDE_MD5=$(md5 -q "$CLAUDE_FILE")
    GEMINI_MD5=$(md5 -q "$GEMINI_FILE")
else
    exit 0
fi

if [ "$AGENTS_MD5" != "$CLAUDE_MD5" ] || [ "$AGENTS_MD5" != "$GEMINI_MD5" ]; then
    echo "⚠️  Git commit 被拒绝"
    echo ""
    echo "AGENTS.md、CLAUDE.md、GEMINI.md 三个文件的内容不一致。"
    echo ""
    echo "正确的流程："
    echo "  1. 编辑 AGENTS.md（不要编辑 CLAUDE.md 或 GEMINI.md）"
    echo "  2. 运行：python .meta/scripts/sync_agents.py"
    echo "  3. 再次提交"
    exit 1
fi

# ─── 9. MEMORY.md 记忆索引一致性（硬拦截） ───
# 记忆索引由 memory_index.py 自动维护，不允许依赖 agent 手动更新。
# .meta/memory/** 有变更时，MEMORY.md 索引段必须与磁盘实际内容一致。
MEMORY_CHANGED=0
while IFS= read -r path; do
    case "$path" in
        .meta/memory/*) MEMORY_CHANGED=1 ;;
    esac
done <<< "$STAGED_FILES"

if [ "$MEMORY_CHANGED" -eq 1 ] && [ -f ".meta/scripts/memory_index.py" ] && [ -f ".meta/memory/MEMORY.md" ]; then
    if ! python .meta/scripts/memory_index.py --check; then
        echo ""
        echo "⚠️  Git commit 被拒绝：MEMORY.md 记忆索引过期"
        echo ""
        echo "记忆索引是脚本自动维护的硬约束。请先运行："
        echo "  python .meta/scripts/memory_index.py && git add .meta/memory/MEMORY.md"
        echo "再重新提交。"
        exit 1
    fi
fi

exit 0
